# Generate local secrets with: python scripts/setup_env.py
SANKET_ADMIN_EMAIL=founder@sanketai.local
SANKET_ADMIN_PASSWORD=replace-with-a-long-random-password
POSTGRES_PASSWORD=replace-with-a-long-random-password

SANKET_ENVIRONMENT=development
SANKET_FRONTEND_ORIGIN=http://localhost:5173
SANKET_SECURE_COOKIES=false
SANKET_DEMO_ENABLED=true
SANKET_AGENT_MODE=auto
SANKET_OLLAMA_URL=http://localhost:11434
SANKET_OLLAMA_MODEL=qwen3:8b
# Set SANKET_LLM_PROVIDER=openai to use a hosted model instead of Ollama.
# Hosted OpenAI-compatible model. Prompts (including business data) are sent to this provider.
SANKET_LLM_PROVIDER=ollama
SANKET_LLM_BASE_URL=https://api.groq.com/openai/v1
SANKET_LLM_API_KEY=
SANKET_LLM_MODEL=openai/gpt-oss-120b
SANKET_LLM_REASONING_EFFORT=low
# Backup models on the same provider, tried in order when the main one is rate-limited (say a daily limit) or down.
SANKET_LLM_FALLBACK_MODELS=openai/gpt-oss-20b
# 0 = the tools run without model planning and the model writes only the conclusion (one call;
# best for free hosted tiers). 4-20 = the model plans that many tool steps first.
SANKET_MAX_AGENT_STEPS=10
SANKET_MODEL_TIMEOUT=60
# Native development defaults to SQLite. Docker overrides this with PostgreSQL.
SANKET_DATABASE_URL=sqlite:///./sanketai.db
